# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (from the Qloo email). Leave empty to use the offline demo catalogue.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Claude agent. Leave empty to use rule-based explanations.
ANTHROPIC_API_KEY=

# Supabase (needed on Vercel so huddles survive across serverless instances).
# Run supabase/schema.sql first. Service-role key is used server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Agent budget guard (optional)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_DAILY_LIMIT=100
# AGENT_IP_HOURLY_LIMIT=6
# AGENT_IP_SALT=<random string>
