# Copy to .env.local and fill in. Never commit .env.local.

# Qloo hackathon key (from the Qloo email). Leave empty to use the offline demo catalogue.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Claude agent. Leave empty to use rule-based explanations.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (needed on Vercel so huddles survive across serverless instances).
# Run supabase/schema.sql first. Service-role key is used server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
